# Copy to .env for local dev. The Makefile does not require this; it only
# sets defaults for commands run outside docker-compose.

# ---- API ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/migration
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
API_BIND=0.0.0.0:8080
METRICS_BIND=0.0.0.0:9464
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---- MinIO ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=migration

# ---- Secrets (dev only) ----
MASTER_KEY=dev-master-key-change-me-000000000000000000000000
JWT_PRIVATE_KEY_PATH=./infra/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./infra/secrets/jwt_public.pem

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8080
