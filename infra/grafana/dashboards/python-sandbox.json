{
  "uid": "mp-sandbox",
  "title": "Migration Platform — Python Sandbox",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["migration-platform"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Sandbox executions / sec",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(python_sandbox_executions_total[1m]))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sandbox execution latency (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(python_sandbox_execution_seconds_bucket[5m])))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sandbox timeouts / OOM / escapes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(python_sandbox_timeouts_total[5m])", "legendFormat": "timeouts", "refId": "A" },
        { "expr": "rate(python_sandbox_oom_kills_total[5m])", "legendFormat": "oom", "refId": "B" },
        { "expr": "rate(python_sandbox_escape_attempts_total[5m])", "legendFormat": "escapes", "refId": "C" }
      ]
    },
    {
      "type": "stat",
      "title": "Fuzz regressions hit",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "increase(python_sandbox_fuzz_hits_total[24h])", "refId": "A" }
      ]
    }
  ]
}
